# ==============================================================================
#                      SHOPLUXE E-COMMERCE PRODUCTION / DEV ENV
# ==============================================================================
# Ushbu fayl loyihaning barcha muhit o'zgaruvchilari (Environment Variables)
# va API kalitlari uchun shablon hisoblanadi.
# Yangi serverga deploy qilishda ushbu fayldan nusxa olib `.env` deb nomlang
# va o'zingizning maxfiy kalitlaringizni kiriting:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TIZIM VA PORTLAR (APPLICATION PORTS)
# ------------------------------------------------------------------------------
# Frontend (Nginx yoki Vite dev server) porti:
FRONTEND_PORT=3000

# Backend Spring Boot server porti:
BACKEND_PORT=8080

# PostgreSQL ma'lumotlar bazasi tashqi porti:
DB_PORT=5432

# Redis kesh serveri porti:
REDIS_PORT=6379

# RabbitMQ xabarlar navbati asosiy porti:
RABBITMQ_PORT=5672

# RabbitMQ Web Management konsol porti (brauzerda monitoring qilish uchun: http://localhost:15672):
RABBITMQ_MGMT_PORT=15672


# ------------------------------------------------------------------------------
# 2. MA'LUMOTLAR BAZASI (POSTGRESQL CONFIGURATION)
# ------------------------------------------------------------------------------
# Ma'lumotlar bazasi nomi:
POSTGRES_DB=commerce

# Baza foydalanuvchi nomi (Production'da 'postgres' o'rniga maxsus nom tanlang):
POSTGRES_USER=admin2003

# Baza foydalanuvchi paroli (Production'da kamida 12+ belgili murakkab parol qo'ying!):
POSTGRES_PASSWORD=admin2003


# ------------------------------------------------------------------------------
# 3. RABBITMQ XABARLAR NAVBATI (MESSAGE BROKER)
# ------------------------------------------------------------------------------
# RabbitMQ foydalanuvchi login va paroli (Default: guest/guest faqat localhost uchun).
# Production muhitida maxsus user yaratish tavsiya etiladi.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest


# ------------------------------------------------------------------------------
# 4. JWT XAVFSIZLIK SOZLAMALARI (JSON WEB TOKEN)
# ------------------------------------------------------------------------------
# [MUHIM KEY]: JWT imzolash uchun maxfiy kalit (Secret Key).
# Xavfsizlik talabi: HMAC-SHA256 algoritmi uchun kamida 256-bit (kamida 32 ta belgi)
# bo'lgan tasodifiy murakkab satr bo'lishi SHART!
# Kalit yaratish uchun Linux terminalida: `openssl rand -base64 32`
JWT_SECRET=uzbekistan_uzbekistan_0123456789_production_secret_key_32chars

# Access token amal qilish muddati (millisekundda). Masalan: 900000 ms = 15 daqiqa
JWT_ACCESS=900000

# Refresh token amal qilish muddati (millisekundda). Masalan: 604800000 ms = 7 kun
JWT_REFRESH=604800000


# ------------------------------------------------------------------------------
# 5. EMAIL SMTP SOZLAMALARI (GMAIL YUBORISH TIZIMI)
# ------------------------------------------------------------------------------
# Foydalanuvchilar ro'yxatdan o'tganda OTP tasdiqlash kodi, parolni tiklash
# va yangi buyurtma bildirishnomalarini yuborish uchun ishlatiladi.
# 
# [GMAIL APP PASSWORD OLISH YO'RIQNOMASI]:
# 1. Google hisobingizga kiring: https://myaccount.google.com/security
# 2. "2 bosqichli tasdiqlash" (2-Step Verification) ni yoqing.
# 3. Qidiruvdan "Ilova parollari" (App passwords) bo'limiga o'ting.
# 4. Yangi ilova nomini kiriting (masalan, "ShopLuxe") va "Yaratish" tugmasini bosing.
# 5. Generatsiya qilingan 16 belgili maxsus parolni (bo'shliqlarsiz) MAIL_PASSWORD ga yozing.
MAIL_USERNAME=abdusharipovizzat03@gmail.com
MAIL_PASSWORD=khgcufxqqhtmqxca


# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH2 SOZLAMALARI (GOOGLE BILAN KIRISH)
# ------------------------------------------------------------------------------
# Foydalanuvchilar "Google orqali kirish" tugmasini bosganda ishlaydi.
#
# [GOOGLE OAUTH2 KALITLARINI OLISH YO'RIQNOMASI]:
# 1. Google Cloud Console ga kiring: https://console.cloud.google.com/
# 2. Yangi loyiha (Project) yarating yoki mavjudini tanlang.
# 3. "APIs & Services" -> "OAuth consent screen" bo'limida dastur turini (External) tanlang.
# 4. "Credentials" -> "Create Credentials" -> "OAuth client ID" ni tanlang.
# 5. Application type: "Web application".
# 6. "Authorized redirect URIs" qatoriga quyidagini qo'shing:
#    - Development uchun: http://localhost:8080/api/v1/login/oauth2/code/google
#    - Production uchun: https://sizning-domeningiz.uz/api/v1/login/oauth2/code/google
# 7. Yaratilgan Client ID va Client Secret ni pastga kiriting:
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here


# ------------------------------------------------------------------------------
# 7. MANZILLAR VA FAYL YUKLASH (URLS & FILE UPLOADS)
# ------------------------------------------------------------------------------
# Frontend mijoz domeni (CORS va OAuth redirectlari to'g'ri ishlashi uchun):
# Dev: http://localhost:3000 yoki http://localhost:5173
# Prod: https://shop.example.com
CLIENT_URL=http://localhost:3000

# Mahsulot rasmlari saqlanadigan server papkasi:
# Docker muhitida: /app/uploads
# Mahalliy testda: ./uploads
UPLOAD_DIR=/app/uploads
